{
  "version": 1,
  "rules": {
    "deterministic": {
      "SharpS": {
        "mode": "regex",
        "mappings": [
          {
            "from": "sz",
            "to": "ß"
          }
        ]
      },
      "LineSeparator": {
        "mode": "regex",
        "mappings": [
          {
            "to": "¬",
            "from": "=$"
          },
          {
            "to": "¬",
            "from": "₌$"
          },
          {
            "to": "¬",
            "from": "—$"
          },
          {
            "to": "¬",
            "from": "-$"
          },
          {
            "to": "¬",
            "from": "⸗$"
          }
        ]
      },
      "DoubleObliqueHyphen": {
        "mode": "regex",
        "mappings": [
          {
            "to": "-",
            "from": "⸗(?=.)"
          }
        ]
      },
      "LongS": {
        "mappings": [
          {
            "from": "ſ",
            "to": "s"
          }
        ]
      },
      "RotundR": {
        "mappings": [
          {
            "from": "ꝛ",
            "to": "r"
          }
        ]
      },
      "OldUmlaut": {
        "mappings": [
          {
            "from": "aͤ",
            "to": "ä"
          },
          {
            "from": "oͤ",
            "to": "ö"
          },
          {
            "from": "uͤ",
            "to": "ü"
          }
        ]
      }
    },
    "non-deterministic": {
      "DoubleObliqueHyphen": {
        "mappings": [
          {
            "from": "⸗",
            "to": "¬"
          },
          {
            "from": "⸗",
            "to": "—"
          },
          {
            "from": "⸗",
            "to": "-"
          }
        ]
      },
      "JtoI": {
        "mappings": [
          {
            "from": "J",
            "to": "I"
          }
        ]
      }
    }
  },
  "profiles": {
    "PagePlus-Normalization": {
      "description": "Historic GT normalization rules",
      "rules": {
        "deterministic": [
          "LineSeparator",
          "DoubleObliqueHyphen",
          "LongS"
        ]
      }
    }
  }
}